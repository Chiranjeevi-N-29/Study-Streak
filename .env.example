# StudyStreak Environment Variables Configuration Template
# Copy this file to '.env' in the root or backend directories and fill in actual credentials.
# Do NOT commit the '.env' file containing real secrets to Git.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studystreak?schema=public"

# Authentication
JWT_SECRET="generate_a_secure_random_string_in_production"
